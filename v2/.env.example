# Copy to .env and edit. Nothing here is read automatically; export the
# variables in your shell or load the file with direnv / python-dotenv.

HOUSISENSE_DB_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/housisense

# Hugging Face id or a local directory
HOUSISENSE_GEN_MODEL=HuggingFaceH4/zephyr-7b-beta
HOUSISENSE_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2

# Optional, raises the Socrata rate limit for scripts/fetch_311.py
SOCRATA_APP_TOKEN=
